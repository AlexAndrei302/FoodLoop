<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    android:background="#F5F9F5">

    <TextView
        android:id="@+id/txt_scan_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Produkt scannen"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="12dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <ImageView
            android:id="@+id/photo_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Produktfotografie"
            android:background="#000000"
            android:visibility="gone"/>

    </FrameLayout>

    <TextView
        android:id="@+id/txt_scan_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Richte die Kamera auf das Produkt."
        android:textSize="16sp"
        android:gravity="center"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btn_capture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Foto aufnehmen"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btn_confirm_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Foto verwenden"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btn_retake_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Erneut aufnehmen"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btn_cancel_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Abbrechen"/>

</LinearLayout>

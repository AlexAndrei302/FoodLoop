<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Base.Theme.FoodLoop"
        parent="Theme.Material3.Dark.NoActionBar">

        <!-- PRIMARY -->

        <item name="colorPrimary">
            @color/foodloop_primary
        </item>

        <item name="colorOnPrimary">
            @color/foodloop_on_primary
        </item>

        <item name="colorPrimaryContainer">
            @color/foodloop_container
        </item>

        <item name="colorOnPrimaryContainer">
            @color/foodloop_primary
        </item>

        <!-- SECONDARY -->

        <item name="colorSecondary">
            @color/foodloop_accent
        </item>

        <item name="colorOnSecondary">
            @color/foodloop_on_primary
        </item>

        <item name="colorSecondaryContainer">
            @color/foodloop_container
        </item>

        <item name="colorOnSecondaryContainer">
            @color/foodloop_text
        </item>

        <!-- SURFACES -->

        <item name="colorSurface">
            @color/foodloop_surface
        </item>

        <item name="colorOnSurface">
            @color/foodloop_text
        </item>

        <item name="colorSurfaceVariant">
            @color/foodloop_surface_variant
        </item>

        <item name="colorOnSurfaceVariant">
            @color/foodloop_text_secondary
        </item>

        <item name="colorOutline">
            @color/foodloop_border
        </item>

        <!-- ERROR -->

        <item name="colorError">
            @color/foodloop_error
        </item>

        <item name="colorOnError">
            @color/foodloop_background
        </item>

        <!-- WINDOW -->

        <item name="android:windowBackground">
            @color/foodloop_background
        </item>

        <item name="android:statusBarColor">
            @color/foodloop_background
        </item>

        <item name="android:navigationBarColor">
            @color/foodloop_background
        </item>

        <item name="android:windowLightStatusBar">
            false
        </item>

        <item name="android:windowLightNavigationBar">
            false
        </item>

        <item name="android:forceDarkAllowed">
            false
        </item>

        <item name="android:fontFamily">
            sans-serif
        </item>

    </style>

    <style name="Theme.FoodLoop"
        parent="Base.Theme.FoodLoop"/>

</resources>
